# Copy this file to backend/.env and set values for your environment.
DATABASE_URL=sqlite:///../brightloop.db
COMPANY_STATE=Kerala

# SMTP credentials are required only when sending invoice email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Razorpay test-mode credentials. The key secret stays on the backend only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
